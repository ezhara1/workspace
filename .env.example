# Hugging Face repo to pull a GGUF model from
MODEL_REPO=HauhauCS/Qwen3.5-35B-A3B-Uncensored-HauhauCS-Aggressive

# File inside ./models used by llama.cpp server
# This is auto-populated by scripts/setup.sh
MODEL_FILE=

# llama.cpp runtime tuning
CTX_SIZE=8192
N_GPU_LAYERS=0
THREADS=8
PARALLEL_REQUESTS=1

# Open WebUI runtime
WEBUI_AUTH=True
ENABLE_SIGNUP=False
OPENAI_API_KEY=unused
DEFAULT_MODELS=llama.cpp

# Voice mode (independent service)
VOICE_MODE_ASR_MODEL=microsoft/VibeVoice-ASR-HF
VOICE_MODE_TTS_MODEL=microsoft/VibeVoice-Realtime-0.5B
BRAIN_SYSTEM_PROMPT=You are a helpful conversational assistant. Keep answers concise, clear, and natural for spoken playback.

# Optional token for gated/private HF repos and higher limits
# HF_TOKEN=hf_xxx
