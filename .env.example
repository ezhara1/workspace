# Hugging Face repo to pull a GGUF model from
MODEL_REPO=HauhauCS/Qwen3.5-35B-A3B-Uncensored-HauhauCS-Aggressive

# File inside ./models used by llama.cpp server
# This is auto-populated by scripts/setup.sh
MODEL_FILE=

# llama.cpp runtime tuning
CTX_SIZE=8192
N_GPU_LAYERS=0
THREADS=8
PARALLEL_REQUESTS=1
# Qwen3.5 thinking mode control for llama-cpp-python server:
# true  -> keep default thinking behavior
# false -> pass chat_template_kwargs {"enable_thinking": false}
ENABLE_THINKING=false

# Open WebUI runtime
WEBUI_AUTH=True
ENABLE_SIGNUP=False
OPENAI_API_KEY=unused
DEFAULT_MODELS=llama.cpp

# VibeVoice OpenAI-compatible TTS API (used by Open WebUI)
VIBEVOICE_API_PORT=9001
VIBEVOICE_REQUIRE_CUDA=true
VIBEVOICE_TTS_MODEL=microsoft/VibeVoice-Realtime-0.5B
VIBEVOICE_STRIP_THINK_FOR_TTS=true

# Optional token for gated/private HF repos and higher limits
# HF_TOKEN=hf_xxx
